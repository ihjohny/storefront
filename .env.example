NEXT_PUBLIC_API_URL=http://localhost:3000/api
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001

# Match BS-Commerce AUTH_REQUIRED_IDENTIFIER (forgot password + labels).
NEXT_PUBLIC_AUTH_REQUIRED_IDENTIFIER=either
NEXT_PUBLIC_MULTIVENDOR_ENABLED=false
NEXT_PUBLIC_GUEST_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SOCIAL_LOGIN_ENABLED=true
NEXT_PUBLIC_REVIEWS_ENABLED=true
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,bn
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_SUPPORTED_CURRENCIES=USD,BDT
NEXT_PUBLIC_MULTI_STORE_ENABLED=true
# Match backend GEOGRAPHY_ENABLED for area-based store list (subdivisions / localities).
NEXT_PUBLIC_GEOGRAPHY_ENABLED=true
NEXT_PUBLIC_SINGLE_STORE_CART=true
NEXT_PUBLIC_GEO_LOCATION_TIER_FILTER=served_and_extended
NEXT_PUBLIC_GEO_LIST_ONLY_SERVED=true

# PDP: fetch GET /api/storefront/variant-availability — disables Add to cart when the SKU cannot be allocated (qty 1) at the selected store. Default **on** when unset; set false | 0 | no | off | hide | hidden to disable (fewer requests; cart may still return 400 if backend validates warehouse lines).
# NEXT_PUBLIC_WAREHOUSE_AVAILABILITY_UI=false

# PDP: mobile hero gallery prev/next + counter overlay (outlined). false | hidden | hide | 0 | off | no = hidden (swipe + thumbnails only). Omit = shown.
# NEXT_PUBLIC_PDP_GALLERY_MOBILE_ARROWS=false

# PDP: collapsible product description starts expanded. true | open | 1 | expanded | yes = open. Omit = collapsed.
# NEXT_PUBLIC_PDP_DESCRIPTION_DEFAULT_OPEN=true

# PLP product cards: small “available here” badge when listing uses stock-location filter (Q6). Default off.
# NEXT_PUBLIC_PRODUCT_CARD_STOCK_BADGES_ON_CARDS=true

# Quick View modal on listing cards. Default on; false | 0 | off | hidden | hide = disabled.
# NEXT_PUBLIC_QUICK_VIEW_ENABLED=false

# Product comparison (listing + PDP + /compare). Default on; false | 0 | off | hidden | hide = disabled.
# NEXT_PUBLIC_PRODUCT_COMPARE_ENABLED=false

# When Quick View is on: listing card image/title click — pdp (default, navigate to PDP) | quickview | quick_view | modal
# NEXT_PUBLIC_LISTING_PRODUCT_CARD_CLICK=quickview

# Optional cart page countdown (minutes). Omit or 0 = hidden.
# NEXT_PUBLIC_CART_URGENCY_COUNTDOWN_MINUTES=15

# Checkout: omit or any value except "false" sends simulatePayment when the API allows (dev/admin).
# NEXT_PUBLIC_CHECKOUT_SIMULATE_PAYMENT=false

# First-visit auto default area+store. true = legacy demo. false/omit = explicit selection.
# NEXT_PUBLIC_AUTO_SELECT_DEFAULT_SERVICE_AREA=true

# “Use my location” (reverse geocode via server; geocoder/region policy is configured in code / env).
# NEXT_PUBLIC_GEOLOCATION_PREFILL=true
# GEOCODER_PROVIDER=nominatim
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT="MyStore/1.0 (contact@example.com)"
# GEOCODER_CACHE_TTL_SEC=604800
# GEOCODER_ACCEPT_LANGUAGE=en,en-US

# Contact page ([locale]/contact) — mailto target when the visitor submits the form (omit to hide/disable mail link behavior).
# NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
